# Public endpoint URLs, never secret API keys. All must allow client CORS on web.
# Defaults work for small development evaluations only. Configure managed or
# self-hosted endpoints before public release. Keep these provider response formats.
EXPO_PUBLIC_PHOTON_URL=https://photon.komoot.io/api/
# Default is Valhalla with its motorcycle costing profile. Set provider=osrm
# only when using an OSRM-compatible driving endpoint intentionally.
EXPO_PUBLIC_ROUTE_URL=https://valhalla1.openstreetmap.de/route
EXPO_PUBLIC_ROUTE_PROVIDER=valhalla
EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Native builds only. Use a restricted Google Maps key for Android/iOS; do not
# prefix it with EXPO_PUBLIC_ because it is configured at build time.
GOOGLE_MAPS_API_KEY=
